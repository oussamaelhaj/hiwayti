rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User avatars — owner only
    match /avatars/{userId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024   // 5 MB max
        && request.resource.contentType.matches('image/.*');
    }

    // Provider media — provider owner only
    match /providers/{providerId}/{fileName} {
      allow read: if true;  // Public
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024  // 20 MB max
        && request.resource.contentType.matches('image/.*');
    }

    // Product images — authenticated providers
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Everything else — deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
